


import pandas as pd
import numpy as np

df_items = pd.read_csv(
    "../data/raw/olist_order_items_dataset.csv",
    dtype={
        "order_id": "string",
        "product_id": "string",
        "seller_id": "string"
    }
)

print("Dataset loaded successfully!")


print("Shape:", df_items.shape)
display(df_items.head())


df_items.info()


display(df_items.isnull().sum())


display(df_items.describe(include="all").T)


print("Duplicate rows:", df_items.duplicated().sum())





print("Exact duplicate rows:", df_items.duplicated().sum())

print(
    "Duplicate order-item combinations:",
    df_items.duplicated(
        subset=["order_id", "order_item_id"]
    ).sum()
)


# rders containing multiple items
items_per_order = (
    df_items.groupby("order_id")
    .size()
    .reset_index(name="total_items")
)

print("Total unique orders:", len(items_per_order))
print("Orders with multiple items:",
      (items_per_order["total_items"] > 1).sum())

display(
    items_per_order["total_items"]
    .value_counts()
    .sort_index()
    .head(10)
)








product_summary = df_items.groupby("product_id").agg(
    total_units_sold=("order_item_id", "count"),
    total_orders=("order_id", "nunique"),
    total_revenue=("price", "sum")
).reset_index()

print("Unique products sold:", product_summary["product_id"].nunique())
print("Total units sold:", product_summary["total_units_sold"].sum())

print("\nTop 10 products by units sold:")
display(
    product_summary.sort_values(
        "total_units_sold", ascending=False
    ).head(10)
)








print(
    "Average items per order:",
    round(items_per_order["total_items"].mean(), 2)
)

print(
    "Median items per order:",
    items_per_order["total_items"].median()
)

print(
    "Maximum items in one order:",
    items_per_order["total_items"].max()
)

print("\nTop 10 orders by item count:")

display(
    items_per_order.sort_values(
        "total_items", ascending=False
    ).head(10)
)





top_products_revenue = (
    product_summary
    .sort_values("total_revenue", ascending=False)
    .head(10)
)

display(top_products_revenue)








seller_summary = df_items.groupby("seller_id").agg(
    total_units_sold=("order_item_id", "count"),
    total_orders=("order_id", "nunique"),
    total_revenue=("price", "sum")
).reset_index()

top_sellers_revenue = seller_summary.sort_values(
    "total_revenue", ascending=False
).head(10)

display(top_sellers_revenue)








quantity_distribution = (
    df_items.groupby("order_id")
    .size()
    .value_counts()
    .sort_index()
    .reset_index()
)

quantity_distribution.columns = [
    "items_per_order",
    "number_of_orders"
]

quantity_distribution["percentage"] = (
    quantity_distribution["number_of_orders"] /
    quantity_distribution["number_of_orders"].sum() * 100
).round(2)

display(quantity_distribution)








print("Average price:", round(df_items["price"].mean(), 2))
print("Median price:", round(df_items["price"].median(), 2))
print("Minimum price:", df_items["price"].min())
print("Maximum price:", df_items["price"].max())

display(df_items["price"].describe())


import matplotlib.pyplot as plt

plt.figure(figsize=(10, 5))
plt.hist(df_items["price"], bins=50)
plt.title("Product Price Distribution")
plt.xlabel("Price (BRL)")
plt.ylabel("Number of Order Items")
plt.tight_layout()
plt.show()








print("Average freight:", round(df_items["freight_value"].mean(), 2))
print("Median freight:", round(df_items["freight_value"].median(), 2))
print("Minimum freight:", df_items["freight_value"].min())
print("Maximum freight:", df_items["freight_value"].max())

display(df_items["freight_value"].describe())








seller_revenue = (
    df_items.groupby("seller_id")["price"]
    .sum()
    .sort_values(ascending=False)
    .head(10)
)

display(seller_revenue)








order_value = (
    df_items.groupby("order_id")
    .agg(
        total_order_value=("price", "sum"),
        total_items=("order_item_id", "count")
    )
    .reset_index()
)

display(order_value["total_order_value"].describe())








df_items["freight_percentage"] = (
    df_items["freight_value"] / df_items["price"]
) * 100

display(df_items["freight_percentage"].describe())








df_items_clean = df_items.copy()

df_items_clean["shipping_limit_date"] = pd.to_datetime(
    df_items_clean["shipping_limit_date"],
    errors="coerce"
)

print(df_items_clean.info())
print("Missing shipping dates:", df_items_clean["shipping_limit_date"].isna().sum())


print("Zero prices:", (df_items_clean["price"] == 0).sum())
print("Negative prices:", (df_items_clean["price"] < 0).sum())

print("\nPrice distribution:")
display(df_items_clean["price"].describe())

print("Prices above R$1,000:",
      (df_items_clean["price"] > 1000).sum())


high_price_items = df_items_clean[
    df_items_clean["price"] > 1000
].sort_values("price", ascending=False)

display(high_price_items.head(10))





print("Zero freight:", (df_items_clean["freight_value"] == 0).sum())
print("Negative freight:", (df_items_clean["freight_value"] < 0).sum())
print("Freight above R$100:", (df_items_clean["freight_value"] > 100).sum())





print("Missing values:", df_items_clean.isnull().sum().sum())
print("Exact duplicate rows:", df_items_clean.duplicated().sum())

print(
    "Duplicate order-item combinations:",
    df_items_clean.duplicated(
        subset=["order_id", "order_item_id"]
    ).sum()
)


import os

os.makedirs("../data/processed", exist_ok=True)

df_items_clean.to_csv(
    "../data/processed/order_items_clean.csv",
    index=False
)

print("Cleaned dataset exported successfully!")
print("Final shape:", df_items_clean.shape)






