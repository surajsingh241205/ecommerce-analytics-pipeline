


import pandas as pd
import numpy as np

df_orders = pd.read_csv(
    "../data/raw/olist_orders_dataset.csv",
    dtype={
        "order_id": "string",
        "customer_id": "string",
        "order_status": "string"
    }
)

print("Dataset loaded successfully!")


print("Shape:", df_orders.shape)
print("\nColumns:")
print(df_orders.columns.tolist())


df_orders.info()


display(df_orders.head())


display(df_orders.isnull().sum())


display(df_orders.describe(include="all").T)


print("Duplicate rows:", df_orders.duplicated().sum())
print("Duplicate order IDs:", df_orders["order_id"].duplicated().sum())





status_summary = (
    df_orders["order_status"]
    .value_counts()
    .reset_index()
)

status_summary.columns = ["order_status", "order_count"]

status_summary["percentage"] = (
    status_summary["order_count"] /
    len(df_orders) * 100
).round(2)

display(status_summary)





date_columns = [
    "order_purchase_timestamp",
    "order_approved_at",
    "order_delivered_carrier_date",
    "order_delivered_customer_date",
    "order_estimated_delivery_date"
]

for col in date_columns:
    df_orders[col] = pd.to_datetime(df_orders[col], errors="coerce")

df_orders[date_columns].info()





missing_analysis = df_orders[
    date_columns + ["order_status"]
].isnull().groupby(df_orders["order_status"]).sum()

display(missing_analysis)


timeline_issues = df_orders[
    (df_orders["order_approved_at"] < df_orders["order_purchase_timestamp"]) |
    (df_orders["order_delivered_carrier_date"] < df_orders["order_approved_at"]) |
    (df_orders["order_delivered_customer_date"] < df_orders["order_delivered_carrier_date"])
]

print("Timeline inconsistencies:", len(timeline_issues))

display(timeline_issues.head(10))


timeline_checks = {
    "Approval before purchase": (
        df_orders["order_approved_at"] <
        df_orders["order_purchase_timestamp"]
    ),
    "Carrier before approval": (
        df_orders["order_delivered_carrier_date"] <
        df_orders["order_approved_at"]
    ),
    "Customer delivery before carrier": (
        df_orders["order_delivered_customer_date"] <
        df_orders["order_delivered_carrier_date"]
    )
}

for issue, condition in timeline_checks.items():
    print(f"{issue}: {condition.sum()}")





df_orders_clean = df_orders.copy()

df_orders_clean["timeline_issue"] = (
    (df_orders_clean["order_approved_at"] <
     df_orders_clean["order_purchase_timestamp"]) |
    (df_orders_clean["order_delivered_carrier_date"] <
     df_orders_clean["order_approved_at"]) |
    (df_orders_clean["order_delivered_customer_date"] <
     df_orders_clean["order_delivered_carrier_date"])
)

df_orders_clean.to_csv(
    "../data/processed/orders_clean.csv",
    index=False
)

print("Export completed!")
print("Total records:", len(df_orders_clean))
print("Flagged records:", df_orders_clean["timeline_issue"].sum())





status_summary = (
    df_orders["order_status"]
    .value_counts()
    .reset_index()
)

status_summary.columns = ["order_status", "order_count"]

status_summary["percentage"] = (
    status_summary["order_count"] /
    len(df_orders) * 100
).round(2)

display(status_summary)





df_orders["order_month"] = (
    df_orders["order_purchase_timestamp"].dt.to_period("M")
)

monthly_orders = (
    df_orders.groupby("order_month")
    .size()
    .reset_index(name="total_orders")
)

monthly_orders["order_month"] = (
    monthly_orders["order_month"].astype(str)
)

display(monthly_orders)


import matplotlib.pyplot as plt

plt.figure(figsize=(14, 5))

plt.plot(
    monthly_orders["order_month"],
    monthly_orders["total_orders"],
    marker="o"
)

plt.title("Monthly Order Trends")
plt.xlabel("Month")
plt.ylabel("Number of Orders")
plt.xticks(rotation=45)
plt.grid(alpha=0.3)
plt.tight_layout()


highest_month = monthly_orders.loc[
    monthly_orders["total_orders"].idxmax()
]

lowest_month = monthly_orders.loc[
    monthly_orders["total_orders"].idxmin()
]

print("Highest order month:")
print(highest_month)

print("\nLowest order month:")
print(lowest_month)








df_orders["order_day"] = (
    df_orders["order_purchase_timestamp"].dt.day_name()
)

daily_orders = (
    df_orders["order_day"]
    .value_counts()
    .reindex([
        "Monday", "Tuesday", "Wednesday",
        "Thursday", "Friday", "Saturday", "Sunday"
    ])
    .reset_index()
)

daily_orders.columns = ["day", "total_orders"]

display(daily_orders)








df_orders["month_name"] = (
    df_orders["order_purchase_timestamp"].dt.month_name()
)

monthly_seasonality = (
    df_orders.groupby(
        df_orders["order_purchase_timestamp"].dt.month
    )
    .size()
    .reset_index(name="total_orders")
)

monthly_seasonality["month_name"] = (
    pd.to_datetime(
        monthly_seasonality["order_purchase_timestamp"],
        format="%m"
    ).dt.month_name()
)

display(monthly_seasonality)








total_orders = len(df_orders)

canceled_orders = (
    df_orders["order_status"] == "canceled"
).sum()

cancellation_rate = (
    canceled_orders / total_orders
) * 100

print("Total Orders:", total_orders)
print("Canceled Orders:", canceled_orders)
print("Cancellation Rate:", round(cancellation_rate, 2), "%")








unavailable_orders = (
    df_orders["order_status"] == "unavailable"
).sum()

unavailable_rate = (
    unavailable_orders / len(df_orders)
) * 100

print("Total Orders:", len(df_orders))
print("Unavailable Orders:", unavailable_orders)
print("Unavailable Rate:", round(unavailable_rate, 2), "%")








df_orders["approval_time_hours"] = (
    df_orders["order_approved_at"] -
    df_orders["order_purchase_timestamp"]
).dt.total_seconds() / 3600

valid_approval = df_orders[
    df_orders["approval_time_hours"].notna() &
    (df_orders["approval_time_hours"] >= 0)
]

print("Valid orders:", len(valid_approval))
print("Average approval time:",
      round(valid_approval["approval_time_hours"].mean(), 2), "hours")
print("Median approval time:",
      round(valid_approval["approval_time_hours"].median(), 2), "hours")








df_orders["shipping_time_hours"] = (
    df_orders["order_delivered_carrier_date"] -
    df_orders["order_approved_at"]
).dt.total_seconds() / 3600

valid_shipping = df_orders[
    df_orders["shipping_time_hours"].notna() &
    (df_orders["shipping_time_hours"] >= 0)
]

print("Valid orders:", len(valid_shipping))
print(
    "Average shipping time:",
    round(valid_shipping["shipping_time_hours"].mean(), 2),
    "hours"
)
print(
    "Median shipping time:",
    round(valid_shipping["shipping_time_hours"].median(), 2),
    "hours"
)








df_orders["delivery_time_days"] = (
    df_orders["order_delivered_customer_date"] -
    df_orders["order_purchase_timestamp"]
).dt.total_seconds() / 86400

valid_delivery = df_orders[
    df_orders["delivery_time_days"].notna() &
    (df_orders["delivery_time_days"] >= 0)
]

print("Valid orders:", len(valid_delivery))

print(
    "Average delivery time:",
    round(valid_delivery["delivery_time_days"].mean(), 2),
    "days"
)

print(
    "Median delivery time:",
    round(valid_delivery["delivery_time_days"].median(), 2),
    "days"
)








df_orders["delivery_difference_days"] = (
    df_orders["order_delivered_customer_date"] -
    df_orders["order_estimated_delivery_date"]
).dt.total_seconds() / 86400

valid_estimates = df_orders[
    df_orders["order_delivered_customer_date"].notna()
].copy()

valid_estimates["delivery_result"] = np.where(
    valid_estimates["delivery_difference_days"] < 0,
    "Early",
    np.where(
        valid_estimates["delivery_difference_days"] > 0,
        "Late",
        "On Time"
    )
)

print(valid_estimates["delivery_result"].value_counts())


delivery_summary = (
    valid_estimates["delivery_result"]
    .value_counts()
    .reset_index()
)

delivery_summary.columns = ["delivery_result", "orders"]

delivery_summary["percentage"] = (
    delivery_summary["orders"] /
    len(valid_estimates) * 100
).round(2)

display(delivery_summary)








late_orders = valid_estimates[
    valid_estimates["delivery_difference_days"] > 0
]

print("Late orders:", len(late_orders))

print(
    "Average delay:",
    round(late_orders["delivery_difference_days"].mean(), 2),
    "days"
)

print(
    "Median delay:",
    round(late_orders["delivery_difference_days"].median(), 2),
    "days"
)

print(
    "Maximum delay:",
    round(late_orders["delivery_difference_days"].max(), 2),
    "days"
)








customer_orders = (
    df_orders.groupby("customer_id")["order_id"]
    .nunique()
    .reset_index(name="total_orders")
)

frequency_summary = (
    customer_orders["total_orders"]
    .value_counts()
    .sort_index()
    .reset_index()
)

frequency_summary.columns = [
    "order_frequency",
    "customer_count"
]

frequency_summary["percentage"] = (
    frequency_summary["customer_count"] /
    len(customer_orders) * 100
).round(2)

display(frequency_summary)

print("Total unique customers:", len(customer_orders))
print(
    "Repeat customers:",
    (customer_orders["total_orders"] > 1).sum()
)





df_customers = pd.read_csv(
    "../data/raw/olist_customers_dataset.csv",
    dtype={
        "customer_id": "string",
        "customer_unique_id": "string"
    }
)


orders_customers = df_orders.merge(
    df_customers[["customer_id", "customer_unique_id"]],
    on="customer_id",
    how="left"
)

customer_orders = (
    orders_customers.groupby("customer_unique_id")["order_id"]
    .nunique()
    .reset_index(name="total_orders")
)

frequency_summary = (
    customer_orders["total_orders"]
    .value_counts()
    .sort_index()
    .reset_index()
)

frequency_summary.columns = [
    "order_frequency",
    "customer_count"
]

frequency_summary["percentage"] = (
    frequency_summary["customer_count"] /
    len(customer_orders) * 100
).round(2)

display(frequency_summary)

print("Unique customers:", len(customer_orders))
print(
    "Repeat customers:",
    (customer_orders["total_orders"] > 1).sum()
)






